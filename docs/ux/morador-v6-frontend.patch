+export const materials = { pet: "Garrafa PET", can: "Lata de alumínio" };
+export const demoPolicy = { radius: 100, accuracy: 60, maxAge: 30000 }; // Fixtures, nunca parâmetros de produção.
+export const demoPoints = [
+  {
+    id: "jardim",
+    name: "Condomínio Jardim",
+    address: "Rua das Flores, 120",
+    hours: "Hoje, 8h às 20h",
+    status: "open",
+    accepts: ["pet", "can"],
+    lat: -23.5505,
+    lng: -46.6333,
+    distance: "300 m",
+    temporary: false,
+  },
+  {
+    id: "praca",
+    name: "Praça do bairro",
+    address: "Av. Central, 45",
+    hours: "Hoje, 9h às 18h",
+    status: "full",
+    accepts: ["pet", "can"],
+    lat: -23.552,
+    lng: -46.631,
+    distance: "600 m",
+    temporary: true,
+  },
+  {
+    id: "solar",
+    name: "Condomínio Solar",
+    address: "Rua do Sol, 80",
+    hours: "Amanhã, 8h às 18h",
+    status: "closed",
+    accepts: ["pet"],
+    lat: -23.553,
+    lng: -46.634,
+    distance: "800 m",
+    temporary: false,
+  },
+  {
+    id: "evento",
+    name: "Mutirão da praça",
+    address: "Praça das Árvores",
+    hours: "Encerrado em 08/10/2026",
+    status: "expired",
+    accepts: ["pet", "can"],
+    lat: -23.554,
+    lng: -46.63,
+    distance: "1 km",
+    temporary: true,
+  },
+];
+export const statusLabel = {
+  open: "Disponível",
+  full: "Lotado",
+  closed: "Fechado",
+  expired: "Evento encerrado",
+};
+export function validItems(items) {
+  return (
+    items.length > 0 &&
+    items.every(
+      (i) =>
+        materials[i.material] &&
+        Number.isSafeInteger(i.quantity) &&
+        i.quantity > 0
+    )
+  );
+}
+export function canReceive(point, items) {
+  return (
+    point.status === "open" &&
+    validItems(items) &&
+    items.every((i) => point.accepts.includes(i.material))
+  );
+}
+export function distanceMeters(a, b) {
+  const rad = (d) => (d * Math.PI) / 180;
+  const v =
+    Math.sin(rad(b.lat - a.lat) / 2) ** 2 +
+    Math.cos(rad(a.lat)) *
+      Math.cos(rad(b.lat)) *
+      Math.sin(rad(b.lng - a.lng) / 2) ** 2;
+  return 6371000 * 2 * Math.atan2(Math.sqrt(v), Math.sqrt(1 - v));
+}
+export function validateLocation(location, point, now, policy) {
+  if (!location) return "Ative a localização para verificar sua presença.";
+  if (
+    !Number.isFinite(location.lat) ||
+    !Number.isFinite(location.lng) ||
+    !Number.isFinite(location.accuracy) ||
+    !Number.isFinite(location.timestamp) ||
+    location.accuracy < 0 ||
+    Math.abs(location.lat) > 90 ||
+    Math.abs(location.lng) > 180
+  )
+    return "A localização recebida é inválida. Tente novamente.";
+  if (now - location.timestamp > policy.maxAge || location.timestamp > now)
+    return "A localização expirou. Verifique novamente.";
+  if (location.accuracy > policy.accuracy)
+    return "O GPS está impreciso. Vá para uma área aberta e tente novamente.";
+  if (distanceMeters(location, point) > policy.radius)
+    return "Você ainda está longe do ponto. Verifique ao chegar.";
+  return null;
+}
+export function initialState() {
+  return {
+    stock: [
+      { id: "pet-1", material: "pet", quantity: 4 },
+      { id: "can-1", material: "can", quantity: 2 },
+    ],
+    balance: 30,
+    events: [],
+    rewards: [],
+    operations: {},
+    profile: {
+      name: "Marina",
+      email: "marina@example.com",
+      phone: "(11) 99999-1234",
+    },
+  };
+}
+export function confirmDiscard(state, operation, point, location, now, policy) {
+  if (!operation?.id || !["quick", "stock"].includes(operation.origin))
+    throw Error("Operação de descarte inválida.");
+  if (state.operations[operation.id]) return state;
+  if (!canReceive(point, operation.items))
+    throw Error(
+      "O ponto não pode receber todos os materiais. Escolha outro ponto ou revise os itens."
+    );
+  const error = validateLocation(location, point, now, policy);
+  if (error) throw Error(error);
+  const stock = state.stock.map((i) => ({ ...i }));
+  if (operation.origin === "stock")
+    operation.items.forEach((item) => {
+      const existing = stock.find((i) => i.id === item.id);
+      if (
+        !existing ||
+        existing.material !== item.material ||
+        existing.quantity < item.quantity
+      )
+        throw Error("O estoque mudou. Revise os itens.");
+      existing.quantity -= item.quantity;
+    });
+  const event = {
+    id: operation.id,
+    at: now,
+    point: point.name,
+    items: operation.items.map((i) => ({ ...i })),
+    base: 10,
+    bonus: 0,
+    kind: "discard",
+  };
+  return {
+    ...state,
+    stock: stock.filter((i) => i.quantity > 0),
+    balance: state.balance + 10,
+    events: [event, ...state.events],
+    operations: { ...state.operations, [operation.id]: event },
+  };
+}
+export const offers = [
+  {
+    id: "voucher",
+    kind: "vouchers",
+    title: "Um café no bairro",
+    subtitle: "Café da Praça",
+    cost: 20,
+    available: 3,
+    terms:
+      "Uma bebida pequena. Uso até 31/12/2026, no balcão. Sem transferência ou troca por dinheiro. Regras fictícias para teste.",
+    icon: "☕",
+  },
+  {
+    id: "raffle",
+    kind: "sorteios",
+    title: "Uma bicicleta, novos caminhos",
+    subtitle: "Sorteio da comunidade",
+    cost: 50,
+    available: 100,
+    terms:
+      "Um bilhete por aquisição. Sorteio demonstrativo em 31/12/2026. Resultado e entrega simulados; regulamento real pendente.",
+    icon: "🚲",
+  },
+  {
+    id: "empty",
+    kind: "vouchers",
+    title: "Kit de cuidado com o planeta",
+    subtitle: "Esgotado",
+    cost: 40,
+    available: 0,
+    terms: "Oferta demonstrativa sem estoque.",
+    icon: "🌱",
+  },
+  {
+    id: "campaign",
+    kind: "campanhas",
+    title: "Mais PET, mais circularidade",
+    subtitle: "Conheça a campanha",
+    cost: 0,
+    available: 1,
+    terms:
+      "Simulação de campanha. Elegibilidade, período e cálculo de bônus dependem de validação. Nenhum bônus é creditado ao abrir ou participar.",
+    icon: "♻",
+  },
+];
+export function acquire(state, offer, id) {
+  if (state.operations[id]) return state;
+  if (offer.kind === "campanhas")
+    throw Error(
+      "Bônus depende do descarte elegível e da confirmação do servidor."
+    );
+  const used = state.rewards.filter((r) => r.offerId === offer.id).length;
+  if (used >= offer.available)
+    throw Error("Esta recompensa esgotou. Escolha outra opção.");
+  if (state.balance < offer.cost)
+    throw Error("Você não tem pontos suficientes. Nenhum ponto foi utilizado.");
+  const reward = {
+    id,
+    offerId: offer.id,
+    title: offer.title,
+    cost: offer.cost,
+    kind: offer.kind,
+    at: Date.now(),
+  };
+  return {
+    ...state,
+    balance: state.balance - offer.cost,
+    rewards: [reward, ...state.rewards],
+    events: [{ ...reward, kind: "reward" }, ...state.events],
+    operations: { ...state.operations, [id]: reward },
+  };
+}
