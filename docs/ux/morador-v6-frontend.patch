diff --git a/tests/contracts.test.mjs b/tests/contracts.test.mjs
new file mode 100644
index 0000000..bc6c655
--- /dev/null
+++ b/tests/contracts.test.mjs
@@ -0,0 +1,53 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  integrationStatus,
+  V6_CAPABILITIES,
+  buildDiscardRequest,
+  requireConfirmedDiscard,
+} from "../src/features/morador/contracts.mjs";
+test("capacidades ausentes mantêm produção bloqueada", () => {
+  assert.equal(integrationStatus().ready, false);
+  assert.equal(integrationStatus(V6_CAPABILITIES).ready, true);
+});
+test("pedido rápido não envia IDs de estoque e retry conserva operação", () => {
+  const draft = {
+      id: "op",
+      origin: "quick",
+      items: [
+        { id: "transient", name: "Garrafa", material: "pet", quantity: 2 },
+      ],
+    },
+    gps = { lat: 1, lng: 2, accuracy: 10, timestamp: 1000 };
+  const request = buildDiscardRequest(draft, "point", gps);
+  assert.equal(request.operationId, "op");
+  assert.equal(request.items[0].units, 2);
+  assert.equal("inventoryItemId" in request.items[0], false);
+  assert.deepEqual(buildDiscardRequest(draft, "point", gps), request);
+});
+test("pendente ou 10 por embalagem nunca é tratado como confirmado", () => {
+  for (const response of [
+    { status: "pending" },
+    {
+      operationId: "op",
+      status: "confirmed",
+      discardId: "d",
+      points: { base: 30 },
+      balance: 60,
+    },
+  ])
+    assert.throws(() => requireConfirmedDiscard(response, "op"));
+  assert.equal(
+    requireConfirmedDiscard(
+      {
+        operationId: "op",
+        status: "confirmed",
+        discardId: "d",
+        points: { base: 10, bonus: 0 },
+        balance: 40,
+      },
+      "op"
+    ).balance,
+    40
+  );
+});
diff --git a/tests/model.test.mjs b/tests/model.test.mjs
new file mode 100644
index 0000000..e0f41cc
--- /dev/null
+++ b/tests/model.test.mjs
@@ -0,0 +1,110 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  initialState,
+  confirmDiscard,
+  validateLocation,
+  validItems,
+  canReceive,
+  demoPoints,
+  demoPolicy,
+  acquire,
+  offers,
+} from "../src/features/morador/model.mjs";
+const point = demoPoints[0],
+  now = 100000,
+  gps = { lat: point.lat, lng: point.lng, accuracy: 10, timestamp: now };
+const operation = {
+  id: "op-1",
+  origin: "stock",
+  items: [{ id: "pet-1", material: "pet", quantity: 3 }],
+};
+test("descarte parcial dá 10 por operação e baixa apenas unidades selecionadas", () => {
+  const s = initialState(),
+    n = confirmDiscard(s, operation, point, gps, now, demoPolicy);
+  assert.equal(n.balance, 40);
+  assert.equal(n.stock[0].quantity, 1);
+  assert.equal(s.stock[0].quantity, 4);
+  assert.equal(n.events.length, 1);
+});
+test("repetição da operação é idempotente", () => {
+  const n = confirmDiscard(
+    initialState(),
+    operation,
+    point,
+    gps,
+    now,
+    demoPolicy
+  );
+  assert.equal(confirmDiscard(n, operation, point, gps, now, demoPolicy), n);
+});
+test("rápido não altera estoque", () => {
+  const s = initialState(),
+    n = confirmDiscard(
+      s,
+      { ...operation, origin: "quick" },
+      point,
+      gps,
+      now,
+      demoPolicy
+    );
+  assert.deepEqual(n.stock, s.stock);
+  assert.equal(n.balance, 40);
+});
+test("falha em estoque não produz efeitos parciais", () => {
+  const s = initialState();
+  assert.throws(() =>
+    confirmDiscard(
+      s,
+      {
+        ...operation,
+        items: [
+          ...operation.items,
+          { id: "can-1", material: "can", quantity: 3 },
+        ],
+      },
+      point,
+      gps,
+      now,
+      demoPolicy
+    )
+  );
+  assert.equal(s.balance, 30);
+  assert.equal(s.stock[0].quantity, 4);
+});
+test("inteiros positivos e materiais aceitos", () => {
+  for (const quantity of [0, -1, 1.5, NaN, Infinity])
+    assert.equal(validItems([{ material: "pet", quantity }]), false);
+  assert.equal(validItems([{ material: "paper", quantity: 1 }]), false);
+});
+test("fechado, lotado, expirado e incompatível bloqueiam", () => {
+  for (const p of demoPoints.slice(1))
+    assert.equal(canReceive(p, operation.items), false);
+  assert.equal(
+    canReceive({ ...point, accepts: ["can"] }, operation.items),
+    false
+  );
+});
+test("GPS ausente, inválido, impreciso, antigo e distante bloqueia", () => {
+  for (const g of [
+    null,
+    { ...gps, lat: 91 },
+    { ...gps, accuracy: 61 },
+    { ...gps, timestamp: NaN },
+    { ...gps, timestamp: now - 30001 },
+    { ...gps, lat: 0 },
+  ])
+    assert.ok(validateLocation(g, point, now, demoPolicy));
+  assert.equal(validateLocation(gps, point, now, demoPolicy), null);
+});
+test("voucher debita exatamente o custo e repetição não duplica", () => {
+  const n = acquire(initialState(), offers[0], "buy-1");
+  assert.equal(n.balance, 10);
+  assert.equal(n.rewards.length, 1);
+  assert.equal(acquire(n, offers[0], "buy-1"), n);
+});
+test("saldo insuficiente, oferta esgotada e campanha não creditam nem debitam", () => {
+  for (const offer of offers.slice(1))
+    assert.throws(() => acquire(initialState(), offer, "x"));
+  assert.equal(initialState().balance, 30);
+});
