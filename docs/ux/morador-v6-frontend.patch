+/** Contratos de domínio propostos para negociação. Não definem URLs ou habilitam a API legada. */
+export const V6_CAPABILITIES = Object.freeze([
+  "invite.consumeAtomically",
+  "identification.reviewable",
+  "inventory.integerUnits",
+  "collectionPoints.availability",
+  "discard.atomicTenPoints",
+  "operations.idempotent",
+  "rewards.atomicDebit",
+  "activity.confirmedLedger",
+]);
+
+export function integrationStatus(serverCapabilities = []) {
+  const missing = V6_CAPABILITIES.filter(
+    (capability) => !serverCapabilities.includes(capability)
+  );
+  return { ready: missing.length === 0, missing };
+}
+
+export function buildDiscardRequest(draft, pointId, gps) {
+  if (!draft?.id || !["quick", "stock"].includes(draft.origin))
+    throw Error("Operação de descarte inválida.");
+  return {
+    operationId: draft.id,
+    origin: draft.origin,
+    pointId,
+    items: draft.items.map((item) => ({
+      ...(draft.origin === "stock" ? { inventoryItemId: item.id } : {}),
+      name: item.name,
+      material: item.material,
+      units: item.quantity,
+    })),
+    presence: {
+      latitude: gps.lat,
+      longitude: gps.lng,
+      accuracyMeters: gps.accuracy,
+      capturedAt: new Date(gps.timestamp).toISOString(),
+    },
+  };
+}
+
+export function requireConfirmedDiscard(response, operationId) {
+  if (
+    response?.operationId !== operationId ||
+    response?.status !== "confirmed" ||
+    !response?.discardId ||
+    response?.points?.base !== 10 ||
+    !Number.isFinite(response?.balance)
+  )
+    throw Error(
+      "A operação ainda não tem confirmação V6. Consulte o mesmo identificador antes de repetir."
+    );
+  return response;
+}
